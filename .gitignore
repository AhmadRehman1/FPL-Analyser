.venv/
node_modules/
__pycache__/
*.pyc
db/*.duckdb
db/*.duckdb.wal
data/external/
# ...except the small, hand/Perplexity-built research-pull workbook -- version-controlling it
# means the repo records exactly what evidence the model had each week, and updates go through
# a diff. Rebuild it with scripts/build_evidence_pull_workbook.py; the workflows use this
# committed copy and only fall back to Google Drive if it is missing.
!data/external/FPL_Evidence_Claims_Research_Pull.xlsx
# ...and the raw Perplexity answers it was built from (provenance -- small markdown)
!data/external/evidence_pull_sources/
!data/external/evidence_pull_sources/**
.pytest_cache/
.mypy_cache/
*.egg-info/

# ML research engine generated artifacts
research/ml/results/
research/ml/data/

# chip_timing_analysis.yml matrix: one transient forward-sim artifact per (entry, arm, bundle),
# downloaded and merged by the aggregate job. Only the aggregated reports in data/chip_timing/
# itself (SUMMARY.md, per-team CSVs, chip_timing_latest.json) are committed.
data/chip_timing/arms/
data/lambda_study/arms/

# Track E retrospective validation: cached real-manager sample (aggregate totals only, but
# kept out of git anyway per the plan's "no entry_id, no persistence beyond the fetch step
# guarantee" spirit -- regenerable via scripts/run_retrospective_sample.py)
data/retrospective/
